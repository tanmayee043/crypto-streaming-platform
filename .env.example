POSTGRES_HOST=localhost
POSTGRES_USER=crypto
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crypto_db
POSTGRES_PORT=5432
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Producer: pairs to stream, comma-separated. With Kafka's default partitioner these four
# land on all 3 partitions (BTC+ETH on 0, XRP on 1, SOL on 2).
SYMBOLS=btcusdt,ethusdt,solusdt,xrpusdt

# Anomaly detector (optional, defaults shown)
WINDOW_SIZE=100
PRICE_Z_THRESHOLD=6.0
SIZE_RATIO_THRESHOLD=50
DETECTOR_BATCH_SIZE=500
REBUILD_LOOKBACK=2000

# Storage consumer (optional, defaults shown)
STORAGE_BATCH_SIZE=500
STORAGE_BATCH_TIMEOUT_SECONDS=1.0

# Gap checker (optional, defaults shown)
GAP_CHECK_INTERVAL_SECONDS=60
GAP_CHECK_LOOKBACK_HOURS=24
