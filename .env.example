POSTGRES_HOST=localhost
POSTGRES_USER=crypto
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crypto_db
POSTGRES_PORT=5432
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Producer: pairs to stream, comma-separated. With Kafka's default partitioner these four
# land on all 3 partitions (BTC+ETH on 0, XRP on 1, SOL on 2).
SYMBOLS=btcusdt,ethusdt,solusdt,xrpusdt

# Anomaly detector (optional, defaults shown)
WINDOW_SIZE=100
PRICE_Z_THRESHOLD=6.0
SIZE_RATIO_THRESHOLD=50
DETECTOR_BATCH_SIZE=500
REBUILD_LOOKBACK=2000

# Storage consumer (optional, defaults shown)
STORAGE_BATCH_SIZE=500
STORAGE_BATCH_TIMEOUT_SECONDS=1.0

# Gap checker (optional, defaults shown)
GAP_CHECK_INTERVAL_SECONDS=60
GAP_CHECK_LOOKBACK_HOURS=24

# Alerts (optional). Paste a Discord channel webhook URL (Channel settings -> Integrations ->
# Webhooks) to get anomaly and SLO alerts there. Leave empty to only log them.
DISCORD_WEBHOOK_URL=
ANOMALY_ALERT_INTERVAL_SECONDS=60

# Service levels the dashboard, alerts and Grafana check against (defaults shown)
SLO_COMPLETENESS_PCT=99.9
SLO_LATENCY_P95_SECONDS=2
SLO_CONSUMER_LAG=1000

# Observability (optional): `docker compose --profile observability up -d`, then
# uncomment to send the API's traces to Jaeger (http://localhost:16686)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
GRAFANA_ADMIN_PASSWORD=admin
# Each service serves Prometheus metrics on its own port (producer 8001, detector 8002,
# storage 8003, gap checker 8004; the API on /metrics). METRICS_PORT=0 turns one off.

# Public site limits (optional, defaults shown). RATE_LIMIT_PER_MINUTE=0 turns the limit off.
RATE_LIMIT_PER_MINUTE=300
MAX_STREAMS_PER_IP=5
MAX_REPLAYS_PER_IP=2
MAX_REPLAYS_TOTAL=5

# Retention (optional, defaults shown): run python retention.py to create and prune daily partitions
RETENTION_DAYS=90
